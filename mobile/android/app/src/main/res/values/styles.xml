<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The whole UI is a WebView, so the native theme only supplies the window
         colour and the system bars. It used to be Light.DarkActionBar, which
         flashed a white window before the dark page painted. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorPrimaryDark">@color/brand_bg</item>
        <item name="colorAccent">@color/brand_accent</item>
        <!-- DayNight owns the bars: forcing a dark window and light glyphs made
             the in-app light theme draw white status-bar icons on white. The
             window colour is a day/night pair so a cold start does not flash the
             other theme's background. -->
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- The launch window's background is the inherited windowBackground, not
         `android:background` (a View attribute, ignored here), so the splash is
         declared through the two attributes the splash screen actually reads:
         core-splashscreen's compat drawable on 12-, the system splash on 31+.
         `splash_mark` is the artwork drawn for that size, not the launcher
         foreground (108 dp adaptive, which the system would mask). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
</resources>
